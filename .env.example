POSTGRES_DB=issue_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_HOST=localhost

# Optional - compose.yaml falls back to 9092 when unset.
KAFKA_PORT=9092


JWT_SECRET=change_me
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Origins the browser frontend is served from, comma-separated. Optional - defaults to
# http://localhost:3000 when unset. Must list the deployed frontend's origin in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# Optional - compose.yaml falls back to 9000/9001 when unset.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional - application.properties falls back to http://localhost:${MINIO_PORT} when unset. Set
# this to the backend-reachable address in non-local deployments (e.g. http://minio:9000 inside
# compose, if the backend also runs in a container on the same network).
# Must be https:// in production: the SigV4 signature protects a request's integrity but encrypts
# nothing, so over plain HTTP the uploaded bytes and the signed URL both travel in the clear. The
# app logs a warning at startup when either endpoint is not https.
MINIO_ENDPOINT=http://localhost:9000
# Optional - defaults to MINIO_ENDPOINT. Set this only when the browser reaches MinIO through a
# different address than the backend does (e.g. backend uses the compose service name, browser
# uses a public hostname). Presigned URLs are signed for this address specifically.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Optional - defaults to true. Set to false to skip malware scanning entirely; the usual reason is
# not wanting to wait for clamd's first-run signature download on a dev machine. While it is true
# and clamd is unreachable, avatar uploads fail with 503 rather than being stored unscanned.
STORAGE_AV_ENABLED=true
# Optional - compose.yaml publishes clamd on 3310 and the app defaults to localhost:3310.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Optional - comma-separated reverse-proxy addresses whose X-Forwarded-For header is trusted for
# rate limiting. Empty means the header is ignored entirely, which is the safe default: any client
# can send it, and honoring it unconditionally lets one rotate its own rate-limit bucket forever.
# Behind a proxy in production this MUST be set, or all unauthenticated traffic shares one bucket.
TRUSTED_PROXIES=
# Optional - MinIO ignores the value but the S3 SDK requires one.
MINIO_REGION=us-east-1
# Optional - must be DNS-compliant lowercase.
MINIO_BUCKET=issue-tracker
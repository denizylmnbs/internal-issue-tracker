POSTGRES_DB=issue_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_HOST=localhost

# Optional - compose.yaml falls back to 9092 when unset.
KAFKA_PORT=9092


JWT_SECRET=change_me
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Origins the browser frontend is served from, comma-separated. Optional - defaults to
# http://localhost:3000 when unset. Must list the deployed frontend's origin in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000